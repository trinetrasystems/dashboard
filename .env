# ────────────────────────────────────────────────────────────────────────────
# Trinetra Systems Monitor — environment file
#
# 1. Copy this file to `.env` (in the project root, next to backend/ and frontend/)
# 2. Edit values to match your machine
# 3. Restart the server (python3 app.py) — .env is read at startup
#
# Lines starting with # are comments. Blank lines are ignored.
# Quotes around values are optional — both `KEY=value` and `KEY="value"` work.
# Use forward slashes / on Linux AND Windows — Python normalizes them.
# Absolute paths work everywhere; relative paths are relative to where you run python from.
# ────────────────────────────────────────────────────────────────────────────


# ─── PATHS ─────────────────────────────────────────────────────────────────
# Where SQLite database + image archive + incoming folder live.
# Default if unset: ./data (relative to project root)

# Linux example:
# TRINETRA_DATA=/home/jetson/trinetra-data

# Windows example:
# TRINETRA_DATA=C:/Users/Pratik/trinetra-data

# Default (works on both, recommended for dev):
TRINETRA_DATA=./data


# Path to classes.txt — your YOLO badge labels.
# Default if unset: backend/classes.txt
# TRINETRA_CLASSES=./backend/classes.txt


# Frontend folder location (rarely changed).
# Default if unset: ./frontend
# TRINETRA_FRONTEND=./frontend


# Loitering alerts — the ORIGINAL time-based feature (master switch).
# 0 turns the whole thing off: no alerts are raised, no Telegram/email is sent,
# and the dashboard hides the red banner, the "Active Loitering Alerts" KPI and
# every LOITERING / APPROACHING tag. Intended for vehicle tracking, where a car
# standing in a bay is normal and only movement between bays matters.
# Session housekeeping (auto-closing stale sessions) keeps running either way.
# 1 = on, 0 = off
TRINETRA_LOITER_ALERTS=0


# Movement alerts — event-driven, NOT time-based.
# Sends one alert every time a badge is seen at a DIFFERENT camera than the one
# it was last seen at, plus its first appearance (entry) and exit-gate hits:
#     "CAR-GJ18BR9090 moved from Entrance into Electrical Bay."
# Repeat sightings at the same camera are not movements and never alert.
# Independent of loitering — this fires regardless of how long the badge stayed.
# 1 = on (default), 0 = off
TRINETRA_MOVEMENT_ALERTS=1


# Visit recordings shown by the ▶ button on the Visits tab.
# Point this at any local path — an external drive or NVR mount is fine.
# Files must be named <badge>_<date>.mp4, where <date> is the visit's local
# start date exactly as the Visits table shows it:
#     RED-CIRCLE_20260807.mp4      (2026-08-07 also works)
# Trinetra only reads this directory — it never writes, moves or deletes here.
# Default if unset: ./data/videos
TRINETRA_VIDEO_DIR=./data/videos


# ─── SERVER ────────────────────────────────────────────────────────────────
TRINETRA_HOST=0.0.0.0
TRINETRA_PORT=8000


# ─── JETSON REGISTRY ───────────────────────────────────────────────────────
# Comma-separated list of expected Jetsons.
# Topbar shows "X / Y JETSONS ONLINE" where Y is the count below.
TRINETRA_JETSONS=central,edge-1,edge-2,edge-3

# Seconds after which a heartbeat is considered stale (jetson offline).
TRINETRA_HB_STALE=90


# ─── DETECTION / LOITERING SETTINGS ────────────────────────────────────────
# Alert when a badge has been in premises this many minutes.
TRINETRA_LOITER_MINUTES=15

# Gap (in minutes) between sightings that splits one session from the next.
# Same badge re-detected within this window extends the session; longer than
# this window closes the old session and opens a new one.
TRINETRA_SESSION_GAP_MINUTES=500000

# How long (in minutes) a session can stay "open" with no new detection before
# being auto-closed. After this, if the same badge appears again (e.g. the
# security person handed the badge to someone else), a fresh session opens
# so the two visits are tracked as separate people.
TRINETRA_SESSION_AUTO_CLOSE_MINUTES=500000

# Comma-separated list of cameras whose detections close the session (exit gates).
# When a badge is seen here, the session ends and the badge leaves "in premises".
TRINETRA_EXIT_CAMERAS=cam-exit

# ─── IMAGE CLEANUP ──────────────────────────────────────────────────────────
# Delete archived images older than this many days (runs every 24 hours).
# DB records are kept forever — dashboard shows "NO IMAGE AVAILABLE" for deleted images.
# Set to 0 to disable cleanup and keep images forever.
TRINETRA_IMAGE_RETENTION_DAYS=15

# ─── ADMIN CREDENTIALS ──────────────────────────────────────────────────────
# Login to the admin panel at /admin.html
ADMIN_EMAIL=trinetra@admin.com
ADMIN_PASSWORD=admin@123


# ─── NOTIFICATIONS (optional, leave blank to disable) ──────────────────────

# Telegram — get token from @BotFather, chat_id from getUpdates API
TELEGRAM_TOKEN=8628143016:AAGk6IP15OtxUnlThUNuAm0M_lTNfUdkQWE
TELEGRAM_CHAT_ID=959075448,6417306521

# Email (Gmail SMTP example — needs an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=


# ─── FIREBASE CLOUD MESSAGING (push notifications) ──────────────────────────
# The web config below is PUBLIC by design — it ships inside every Firebase web
# app and only identifies the project. It is served to browsers by
# /api/notifications/config.
FIREBASE_API_KEY=AIzaSyCIxcZYt7JwY6DUJ50DGxOH7S5_0xT2SVI
FIREBASE_AUTH_DOMAIN=trinetra-demo.firebaseapp.com
FIREBASE_PROJECT_ID=trinetra-demo
FIREBASE_STORAGE_BUCKET=trinetra-demo.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=772686068265
FIREBASE_APP_ID=1:772686068265:web:fe5790b53f3e8a70a2ba38

# REQUIRED for the browser to mint a token.
# Console ▸ Project Settings ▸ Cloud Messaging ▸ Web Push certificates ▸ "Key pair"
FIREBASE_VAPID_KEY=BCGVCM2zEwDPBjKppjY78IeStTIYj77vx-gUMNQ_mSPsaSGIKWqIfu-zS9quA9uZxlo9ZGFSw-31_rOmtmHZZxE

# REQUIRED for the backend to SEND. This file is a PRIVATE KEY — keep it out of
# git and never serve it to the frontend.
# Console ▸ Project Settings ▸ Service Accounts ▸ "Generate new private key"
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json

# How long a user stays signed in on a device (days)
TRINETRA_USER_SESSION_DAYS=30

# Public HTTPS origin the dashboard is reachable at, used to build absolute
# notification click-through links. FCM REJECTS a webpush link that is not
# absolute HTTPS — leave blank on localhost and the link is simply omitted
# (the service worker still routes clicks from the data payload).
# Example: TRINETRA_PUBLIC_URL=https://monitor.trinetrasystems.com
TRINETRA_PUBLIC_URL=https://yash-ubuntu.tail3210fb.ts.net

# Android notification channel id — must match the channel the mobile app
# registers with notifee, or background notifications land in Android's
# default channel and may be delivered silently.
TRINETRA_ANDROID_CHANNEL=trinetra-events
