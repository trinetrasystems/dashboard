# ────────────────────────────────────────────────────────────────────────────
# Trinetra Perimeter dashboard — environment file
#
# On a Jetson the trinetra-perimeter skill writes this file for you (data folder → dashboard.env).
# For a laptop test: copy it to `.env` in the project root and restart the server; .env is read at startup.
# Most values can also be changed later on the Settings page (Trinetra team) without a restart.
# ────────────────────────────────────────────────────────────────────────────

# ─── PATHS ─────────────────────────────────────────────────────────────────
# Database, camera images, incoming folder, DeepStream files (default ./data)
TRINETRA_DATA=./data
# Image classes the pipeline writes (default backend/classes.txt)
# TRINETRA_CLASSES=./backend/classes.txt

# ─── SERVER ────────────────────────────────────────────────────────────────
TRINETRA_HOST=0.0.0.0
TRINETRA_PORT=8000

# ─── ALERT RULES (Alerts page) ─────────────────────────────────────────────
# The alert rules themselves are set by the client on the Alerts page (stored in the database).
# Default presence gap: sightings of the same region closer than this many seconds count as ONE presence
# (the detector can miss an object for a while). Each rule can set its own gap (10–3600 s).
TRINETRA_PRESENCE_GAP_SECONDS=60

# ─── VISITS PAGE (presence sessions per class) ─────────────────────────────
# A class seen again after this many minutes starts a new visit.
TRINETRA_SESSION_GAP_MINUTES=5
# A visit not seen for this many minutes is closed.
TRINETRA_SESSION_AUTO_CLOSE_MINUTES=10
# Outside / alert-region classes: a visit ends after this many quiet minutes.
TRINETRA_PERIMETER_GAP_MINUTES=5

# ─── IMAGE CLASSES → ZONES (Live page / Detection Log colours) ─────────────
# The pipeline names each image with its class (backend/classes.txt); these map classes to the zone shown.
TRINETRA_BREACH_BADGES=Boundry-object
TRINETRA_DWELL_BADGES=outside-person:10,outside-object:10
TRINETRA_INSIDE_BADGES=zone-person,zone-object

# ─── NOTIFICATIONS (optional — the site is offline: every alert always shows on the dashboard) ──
# Telegram — needs internet. Token from @BotFather, chat id from getUpdates.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Email — needs internet or a mail server on the site's network.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# ─── SIGN-IN (the Workplace Analytics access model, backend/access.py) ─────
# The Trinetra team: comma-separated user IDs, all with SUPPORT_PASSWORD (empty = nobody can sign in).
# The team makes the client's admin accounts (Admin Accounts page); admins make users (Users page).
SUPPORT_USERNAME=trinetra
SUPPORT_PASSWORD=
# The client's address of this dashboard (sign-in link shown on Admin Accounts), e.g. https://<device>.ts.net:8443
PUBLIC_URL=
# Sign a session out after this many idle minutes, and after this many hours in all (users + team / admins).
TRINETRA_IDLE_MINUTES=60
TRINETRA_SESSION_HOURS=12
TRINETRA_ADMIN_SESSION_HOURS=24
# Extra origins allowed to send changes (a reverse proxy / the Tailscale Funnel address).
TRINETRA_ALLOWED_ORIGINS=
# Activity Logs (Trinetra team) kept this many days (0 = forever)
TRINETRA_AUDIT_RETENTION_DAYS=365

# ─── DISK (housekeeping.py) ────────────────────────────────────────────────
# Camera images kept this many days (today counts as one; 0 = forever); older days are deleted at night.
TRINETRA_IMAGE_RETENTION_DAYS=30
# Disk guard: under this much free space the oldest day of images goes first (never today).
TRINETRA_DISK_MIN_FREE_GB=15
# Nightly database backup on this device (HH:MM, empty = off) and the daily copies kept (data/backups/).
TRINETRA_BACKUP_AT=23:50
TRINETRA_BACKUP_KEEP=7
# One log line per web request (off: the Live page polls every few seconds).
TRINETRA_ACCESS_LOG=0
